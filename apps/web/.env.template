# Default environment variables for generated Celo projects
# Public Celo RPC (mainnet)
CELO_RPC_URL=https://forno.celo.org


# RainbowKit Wallet Configuration
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# TipiTip contract addresses (set after deploying; blank disables that feature)
NEXT_PUBLIC_SUPPORT_ADDRESS_MAINNET=
NEXT_PUBLIC_VAULT_ADDRESS_MAINNET=
NEXT_PUBLIC_SUPPORT_ADDRESS_SEPOLIA=
NEXT_PUBLIC_VAULT_ADDRESS_SEPOLIA=

# Server-only secrets (set in the Vercel dashboard, never committed)
# Vercel Blob store token used by @vercel/blob SDK (auto-read by the SDK)
BLOB_READ_WRITE_TOKEN=
# Shared secret authorizing Vercel Cron to call /api/cron/refresh-leaderboard
CRON_SECRET=
